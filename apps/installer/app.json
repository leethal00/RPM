{
  "expo": {
    "name": "RPM Mobile",
    "slug": "rpm-mobile",
    "owner": "rodier-rpm",
    "scheme": "rpminstall",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "nz.co.rpm.installer",
      "buildNumber": "1",
      "infoPlist": {
        "NSCameraUsageDescription": "Take installation photos for RPM jobs.",
        "NSPhotoLibraryUsageDescription": "Attach installation photos to RPM jobs.",
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "nz.co.rpm.installer",
      "versionCode": 3,
      "adaptiveIcon": {
        "backgroundColor": "#FFFFFF",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.RECORD_AUDIO"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-image-picker",
        {
          "cameraPermission": "Take installation photos for RPM jobs.",
          "photosPermission": "Attach installation photos to RPM jobs."
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "0c2cd86f-9144-43c4-b685-df9e6f9b4744"
      }
    }
  }
}
