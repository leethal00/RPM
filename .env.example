# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
NEXT_PUBLIC_TRAVEL_BASE_ADDRESS=
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Xero
XERO_CLIENT_ID=your-xero-client-id
XERO_CLIENT_SECRET=your-xero-client-secret
# Generated by Xero when you create the webhook subscription.
XERO_WEBHOOK_KEY=your-xero-webhook-key

# Google Maps browser key: restrict to RPM HTTP referrers and Maps JavaScript API + Places API (New).
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=
# JavaScript map ID for production; local fallback is DEMO_MAP_ID.
NEXT_PUBLIC_GOOGLE_MAPS_MAP_ID=
